# Обязательно: токен бота из BotFather (проверка подписи initData)
BOT_TOKEN=123456:ABC-your-bot-token

# Порт API (прод-реестр aeza: NestJS-стек 8910-8920)
PORT=8910

# Локально: без DATABASE_URL — unix socket + peer auth (user zeon), база = PGDATABASE.
PGDATABASE=stalker_lab

# Через docker compose (postgres:16 на хост-порту 5433) — раскомментируй:
# DATABASE_URL=postgres://stalker:stalker@127.0.0.1:5433/stalker_lab

# Неделя 4 (автожурнал): passphrase для AES-256-GCM шифрования apiSecret бирж.
# ОБЯЗАТЕЛЕН для старта (ConnectionsModule падает без него). Сгенерируй:
#   openssl rand -hex 32
CONN_ENC_KEY=change-me-random-hex-64

# Неделя 5 (web-вход по коду из TG): HS256-секрет для JWT ({tg, exp:24h},
# Authorization: Bearer). ОБЯЗАТЕЛЕН для старта (IdentityModule падает без него):
#   openssl rand -hex 32
JWT_SECRET=change-me-random-hex-64

# База BingX (инжектится тестами на локальный мок-сервер; прод — дефолт).
# BINGX_API_BASE=https://open-api.bingx.com
